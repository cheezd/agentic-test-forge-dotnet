<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgenticTestForge.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>forge</ToolCommandName>
    <PackageId>AgenticTestForge</PackageId>
    <Authors>cheezd</Authors>
    <Description>C# quality gates for agentic development (CRAP, mutation, Gherkin).</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cheezd/agentic-test-forge-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cheezd/agentic-test-forge-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.0.2 leaves Stryker's Ignored mutants out of the mutation score. An ignored mutant is outside the diff, so it no longer counts as inconclusive and it no longer lowers the kill rate. NoCoverage, Timeout, and Survived still fail the gate.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticTestForge\AgenticTestForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
